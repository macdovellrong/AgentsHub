<Window x:Class="AgentHub.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AgentHub Native" Height="900" Width="1400"
        Background="#111820">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="AgentHub Native"
                           Foreground="#F2F6FA"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14" />

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="Workspace path" Foreground="#9FB0C2" Margin="0,0,0,6" />
                    <TextBox x:Name="WorkspaceTextBox"
                             MinHeight="34"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Add" Click="AddWorkspace_Click" MinHeight="32" />
                        <Button Grid.Column="2" Content="Browse" Click="BrowseWorkspace_Click" MinHeight="32" />
                        <Button Grid.Column="4" Content="Open" Click="OpenWorkspaceFolder_Click" MinHeight="32" />
                        <Button Grid.Column="6" Content="Remove" Click="RemoveWorkspace_Click" MinHeight="32" />
                    </Grid>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="Workspaces" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <ListBox x:Name="WorkspaceListBox"
                         DockPanel.Dock="Top"
                         MinHeight="140"
                         MaxHeight="220"
                         Background="#0E151D"
                         Foreground="#F2F6FA"
                         BorderBrush="#40566E"
                         SelectionChanged="WorkspaceListBox_SelectionChanged"
                         Margin="0,0,0,14" />

                <TextBlock DockPanel.Dock="Top" Text="Host shell" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <ComboBox x:Name="HostShellComboBox"
                          DockPanel.Dock="Top"
                          MinHeight="34"
                          Background="#0E151D"
                          Foreground="#F2F6FA"
                          BorderBrush="#40566E"
                          SelectedIndex="0"
                          Margin="0,0,0,14">
                    <ComboBoxItem Content="PowerShell" />
                    <ComboBoxItem Content="cmd" />
                </ComboBox>

                <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="3" Margin="0,0,0,14">
                    <Button Content="Start Codex" Click="StartCodex_Click" Margin="0,0,6,6" MinHeight="36" />
                    <Button Content="Resume Codex" Click="ResumeCodex_Click" Margin="6,0,0,6" MinHeight="36" />
                    <Button Content="Start Claude" Click="StartClaude_Click" Margin="0,6,6,6" MinHeight="36" />
                    <Button Content="Start Gemini" Click="StartGemini_Click" Margin="6,6,0,6" MinHeight="36" />
                    <Button Content="Start Shell" Click="StartPowerShell_Click" Margin="0,6,6,0" MinHeight="36" />
                </UniformGrid>

                <TextBlock DockPanel.Dock="Top" Text="Conversations" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBox x:Name="ConversationTopicTextBox"
                             Text="Discuss current workspace"
                             MinHeight="32"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E"
                             Margin="0,0,0,6" />
                    <TextBox x:Name="ConversationParticipantsTextBox"
                             Text="claude,codex"
                             MinHeight="32"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E"
                             Margin="0,0,0,6" />
                    <Button Content="Start manager"
                            Click="StartManagerConversation_Click"
                            MinHeight="32"
                            Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Roundtable"
                                Click="StartRoundtableConversation_Click"
                                MinHeight="32" />
                        <Button Grid.Column="2"
                                Content="Pair"
                                Click="StartPairNegotiationConversation_Click"
                                MinHeight="32" />
                    </Grid>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="Task Plans" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <ComboBox x:Name="TaskPlanSourceComboBox"
                              MinHeight="32"
                              Background="#0E151D"
                              Foreground="#F2F6FA"
                              BorderBrush="#40566E"
                              SelectionChanged="TaskPlanSourceComboBox_SelectionChanged"
                              Margin="0,0,0,6" />
                    <TextBox x:Name="TaskPlanTitleTextBox"
                             MinHeight="32"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E"
                             Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Refresh plans"
                                Click="RefreshTaskPlans_Click"
                                MinHeight="32" />
                        <Button Grid.Column="2"
                                Content="Create plan"
                                Click="CreateTaskPlan_Click"
                                MinHeight="32" />
                    </Grid>
                    <ListBox x:Name="TaskPlanListBox"
                             MinHeight="90"
                             MaxHeight="140"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E"
                             SelectionChanged="TaskPlanListBox_SelectionChanged"
                             Margin="0,0,0,6" />
                    <Button Content="Start manager"
                            Click="StartTaskPlanManager_Click"
                            MinHeight="32"
                            Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Pause"
                                Click="PauseTaskPlan_Click"
                                MinHeight="32" />
                        <Button Grid.Column="2"
                                Content="Resume"
                                Click="ResumeTaskPlan_Click"
                                MinHeight="32" />
                        <Button Grid.Column="4"
                                Content="Archive"
                                Click="ArchiveTaskPlan_Click"
                                MinHeight="32" />
                    </Grid>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="Sessions" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Interrupt"
                            Click="InterruptSession_Click"
                            MinHeight="34" />
                    <Button Grid.Column="2"
                            Content="Stop selected"
                            Click="StopSession_Click"
                            MinHeight="34" />
                    <Button Grid.Column="4"
                            Content="Stop all"
                            Click="StopAllSessions_Click"
                            MinHeight="34" />
                </Grid>
                <ListBox x:Name="SessionListBox"
                         Background="#0E151D"
                         Foreground="#F2F6FA"
                         BorderBrush="#40566E"
                         SelectionChanged="SessionListBox_SelectionChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Open data"
                            Click="OpenNativeDataFolder_Click"
                            MinHeight="28"
                            MinWidth="82"
                            Margin="10,0,0,0" />
                    <TextBlock x:Name="CurrentSessionTextBlock"
                               Text="No session"
                               Foreground="#F2F6FA"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusTextBlock"
                               DockPanel.Dock="Right"
                               Text="Windows Terminal backend"
                               Foreground="#9FB0C2" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="#05080C" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6">
                <Grid x:Name="TerminalHostGrid" ClipToBounds="True">
                    <TextBlock Text="Select a workspace, then start Codex / Claude / Gemini."
                               Foreground="#718196"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Collaboration timeline" Foreground="#9FB0C2" Margin="0,0,0,6" />
                        <ListBox x:Name="TimelineListBox"
                                 Background="#0E151D"
                                 Foreground="#F2F6FA"
                                 BorderBrush="#40566E" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Conversations" Foreground="#9FB0C2" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="Refresh"
                                        Click="RefreshConversations_Click"
                                        MinHeight="26"
                                        MinWidth="62"
                                        Margin="0,0,6,0" />
                                <Button Content="Open"
                                        Click="OpenConversationFolder_Click"
                                        MinHeight="26"
                                        MinWidth="54"
                                        Margin="0,0,6,0" />
                                <Button Content="Pause"
                                        Click="PauseConversation_Click"
                                        MinHeight="26"
                                        MinWidth="56"
                                        Margin="0,0,6,0" />
                                <Button Content="Resume"
                                        Click="ResumeConversation_Click"
                                        MinHeight="26"
                                        MinWidth="64"
                                        Margin="0,0,6,0" />
                                <Button Content="Stop"
                                        Click="StopConversation_Click"
                                        MinHeight="26"
                                        MinWidth="52" />
                            </WrapPanel>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 x:Name="ConversationListBox"
                                 Background="#0E151D"
                                 Foreground="#F2F6FA"
                                 BorderBrush="#40566E"
                                 SelectionChanged="ConversationListBox_SelectionChanged" />
                        <ListBox Grid.Row="3"
                                 x:Name="ConversationDetailListBox"
                                 Background="#0E151D"
                                 Foreground="#F2F6FA"
                                 BorderBrush="#40566E" />
                    </Grid>
                </Border>

                <Border Grid.Column="4" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Task plan detail" Foreground="#9FB0C2" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Open"
                                    Click="OpenTaskPlanFolder_Click"
                                    MinHeight="26"
                                    MinWidth="60" />
                        </DockPanel>
                        <ListBox Grid.Row="1"
                                 x:Name="TaskPlanTaskListBox"
                                 Background="#0E151D"
                                 Foreground="#F2F6FA"
                                 BorderBrush="#40566E" />
                        <ListBox Grid.Row="3"
                                 x:Name="TaskPlanEventListBox"
                                 Background="#0E151D"
                                 Foreground="#F2F6FA"
                                 BorderBrush="#40566E" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="TargetProfileComboBox"
                          MinHeight="38"
                          Background="#0E151D"
                          Foreground="#F2F6FA"
                          BorderBrush="#40566E"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Selected session" />
                    <ComboBoxItem Content="codex" />
                    <ComboBoxItem Content="claude" />
                    <ComboBoxItem Content="gemini" />
                    <ComboBoxItem Content="powershell" />
                    <ComboBoxItem Content="cmd" />
                </ComboBox>

                <TextBox Grid.Column="2"
                         x:Name="InjectTextBox"
                         MinHeight="64"
                         MaxHeight="140"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#0E151D"
                         Foreground="#F2F6FA"
                         BorderBrush="#40566E"
                         KeyDown="InjectTextBox_KeyDown" />
                <Button Grid.Column="4" Content="Send" Click="SendInput_Click" MinHeight="38" />
            </Grid>
        </Grid>
    </Grid>
</Window>
