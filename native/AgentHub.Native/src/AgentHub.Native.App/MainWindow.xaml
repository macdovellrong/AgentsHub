<Window x:Class="AgentHub.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AgentHub Native" Height="860" Width="1320"
        Background="#111820">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="AgentHub Native" Foreground="#F2F6FA" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="工作目录" Foreground="#9FB0C2" Margin="0,0,0,6" />
                    <TextBox x:Name="WorkspaceTextBox"
                             MinHeight="34"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E"
                             Text="V:\OrderManager" />
                </StackPanel>

                <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="2" Margin="0,0,0,14">
                    <Button Content="启动 Codex" Click="StartCodex_Click" Margin="0,0,6,6" MinHeight="36" />
                    <Button Content="启动 Claude" Click="StartClaude_Click" Margin="6,0,0,6" MinHeight="36" />
                    <Button Content="启动 Gemini" Click="StartGemini_Click" Margin="0,6,6,0" MinHeight="36" />
                    <Button Content="PowerShell" Click="StartPowerShell_Click" Margin="6,6,0,0" MinHeight="36" />
                </UniformGrid>

                <TextBlock DockPanel.Dock="Top" Text="会话" Foreground="#9FB0C2" Margin="0,0,0,6" />
                <ListBox x:Name="SessionListBox"
                         Background="#0E151D"
                         Foreground="#F2F6FA"
                         BorderBrush="#40566E"
                         SelectionChanged="SessionListBox_SelectionChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock x:Name="CurrentSessionTextBlock"
                               Text="未启动会话"
                               Foreground="#F2F6FA"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusTextBlock"
                               DockPanel.Dock="Right"
                               Text="Windows Terminal backend"
                               Foreground="#9FB0C2" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="#05080C" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6">
                <Grid x:Name="TerminalHostGrid" ClipToBounds="True">
                    <TextBlock Text="选择工作目录后启动 Codex / Claude / Gemini。"
                               Foreground="#718196"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#151F2A" BorderBrush="#2E4055" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Hook 消息" Foreground="#9FB0C2" Margin="0,0,0,6" />
                    <ListBox x:Name="HookMessagesListBox"
                             Background="#0E151D"
                             Foreground="#F2F6FA"
                             BorderBrush="#40566E" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InjectTextBox"
                         MinHeight="38"
                         Background="#0E151D"
                         Foreground="#F2F6FA"
                         BorderBrush="#40566E"
                         KeyDown="InjectTextBox_KeyDown" />
                <Button Grid.Column="2" Content="发送输入" Click="SendInput_Click" MinHeight="38" />
            </Grid>
        </Grid>
    </Grid>
</Window>
